extends CanvasLayer

@onready var time_label: Label = $TopBar/TimeLabel
@onready var money_label: Label = $TopBar/MoneyLabel
@onready var skill_label: Label = $TopBar/SkillLabel
@onready var interaction_label: Label = $InteractionLabel
@onready var status_panel: Panel = $StatusPanel

var world_time: Node
var player_ref: Node

func _ready() -> void:
    visible = true
    update_hud()

func _process(_delta: float) -> void:
    if world_time:
        time_label.text = "Time: %s" % world_time.get_time_string()
        status_panel.visible = true
    if player_ref:
        var skill_state = player_ref.get_skills()
        if skill_state:
            var agriculture = skill_state.get_skill_level("agriculture")
            skill_label.text = "Agriculture: Lv. %d" % agriculture
        var inv = player_ref.get_inventory()
        if inv:
            money_label.text = "Ark Credits: %s" % str(int(player_ref.economy.get_player_money()))

func set_world_time(node: Node) -> void:
    world_time = node

func set_player(player: Node) -> void:
    player_ref = player

func update_hud() -> void:
    if time_label:
        time_label.text = "Time: 07:00"
    if money_label:
        money_label.text = "Ark Credits: 150"
    if skill_label:
        skill_label.text = "Agriculture: Lv. 1"

func show_interaction(text: String) -> void:
    if interaction_label:
        interaction_label.text = text

func clear_interaction() -> void:
    if interaction_label:
        interaction_label.text = ""
